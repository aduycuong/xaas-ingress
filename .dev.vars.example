# Copy to .dev.vars (not committed). Used by wrangler dev.
# PlanetScale Postgres: ...?sslmode=verify-full (no sslrootcert: pg reads it as a file path).
DATABASE_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Only when your QStash is not on the default endpoint (regional, or the local dev server).
# QSTASH_URL=
# Optional QStash that workflow runs are started on (same as the runner).
# WORKFLOW_QSTASH_URL=
# WORKFLOW_QSTASH_TOKEN=
# Signing keys of the previous QStash while moving to another one.
# QSTASH_PREVIOUS_CURRENT_SIGNING_KEY=
# QSTASH_PREVIOUS_NEXT_SIGNING_KEY=
# Where Upstash reaches the runner Worker, without a trailing slash.
RUNNER_URL=
# Shared with the xaas-workflows app for POST /runs.
INGRESS_API_TOKEN=
